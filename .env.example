# App
SITE_ADDRESS=localhost
TZ=Europe/Stockholm

# Postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=stabsstod

# Admin user (created by the api on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Session cookie signing (any long random string)
SESSION_SECRET=change-me-long-random-string

# Attachments (plan.md 5.6: default max 25 MB)
MAX_UPLOAD_MB=25
