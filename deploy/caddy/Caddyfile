{$SITE_ADDRESS:localhost} {
  tls internal
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
  handle /api/events* {
    reverse_proxy api:3000 {
      flush_interval -1
    }
  }
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /tiles/* {
    root * /srv/maps
    uri strip_prefix /tiles
    file_server
  }
  handle /map-assets/* {
    root * /srv/maps
    file_server
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}
